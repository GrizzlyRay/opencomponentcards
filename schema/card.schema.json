{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GrizzlyRay/opencomponentcards/schema/v0.2/card.schema.json",
  "$comment": "Placeholder $id: final repo URL is TBD. Schema license: Apache-2.0. Card data license: CC-BY-4.0.",
  "title": "OpenComponentCards Card v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["card_version", "id", "part", "parameters", "derivation", "validation", "sources", "provenance", "license"],
  "properties": {
    "card_version": { "const": "0.2" },
    "card_type": { "const": "part", "description": "Optional. Omit it or use part for a part card. Family cards use family and follow $defs/family_card. See docs/family-cards.md." },
    "id": { "type": "string", "pattern": "^occ:[a-z0-9_-]+/[A-Za-z0-9._-]+@\\d+\\.\\d+\\.\\d+$" },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "mpn", "category"],
      "properties": {
        "manufacturer": { "type": "string" },
        "mpn": { "type": "string" },
        "category": { "enum": ["resistor", "capacitor", "inductor", "diode", "bjt", "mosfet", "ic", "other"] },
        "description": { "type": "string" },
        "package": { "type": "string" },
        "hpm_id": { "type": "string" },
        "jitx_id": { "type": "string" }
      }
    },
    "model_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "uri", "sha256", "signed"],
        "properties": {
          "format": { "enum": ["SPICE", "IBIS", "Touchstone", "Verilog-A"] },
          "dialect": { "type": "string" },
          "uri": { "type": "string" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "model_name": { "type": "string" },
          "signed": { "type": "boolean", "description": "true if the model file itself has its own signature; false if the card only references it by hash" },
          "signature_uri": { "type": "string" }
        }
      }
    },
    "parameters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/parameter" } },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Full correlation matrix over the named parameters (same order). Must be symmetric, unit diagonal, and positive semidefinite so it can drive Monte Carlo sampling.",
      "required": ["parameters", "matrix", "basis"],
      "properties": {
        "parameters": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "matrix": { "type": "array", "items": { "type": "array", "items": { "type": "number", "minimum": -1, "maximum": 1 } } },
        "basis": { "type": "string" }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "method"],
      "properties": { "kind": { "enum": ["physics", "data", "hybrid"] }, "method": { "type": "string" } }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maturity"],
      "properties": {
        "maturity": { "type": "string", "pattern": "^[0-3]\\.\\d+$", "description": "Inspired by IBIS [File Rev] levels; not the IBIS rules themselves" },
        "tested_simulators": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "result"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "result": { "enum": ["pass", "fail", "untested"] } } } },
        "comparisons": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "metric": { "type": "string" }, "dataset_ref": { "type": "string" }, "error": { "type": "string" }, "notes": { "type": "string" } } } }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind", "confidence"],
        "properties": {
          "ref": { "type": "string" },
          "kind": { "enum": ["datasheet", "measurement", "paper", "standard", "application_note", "expert_estimate", "derived"] },
          "derived_from": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" }, "description": "Refs of the upstream sources this one took its data from. Required when kind is derived." },
          "uri": { "type": "string" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "evidence": { "type": "string", "description": "Where exactly, e.g. 'Table 3, p.2'" },
          "confidence": { "$ref": "#/$defs/confidence" }
        },
        "if": { "properties": { "kind": { "const": "derived" } } },
        "then": { "required": ["derived_from"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "created"],
      "properties": {
        "author": { "type": "string" },
        "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "ISO 8601 date. Quote it in YAML." },
        "previous_version": { "oneOf": [ { "$ref": "#/$defs/sha256" }, { "type": "null" } ], "description": "sha256 of the exact bytes of the prior card file" },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "bundle_uri", "identity", "issuer"],
            "properties": {
              "method": { "const": "sigstore" },
              "bundle_uri": { "type": "string", "pattern": "\\.sigstore\\.json$" },
              "identity": { "type": "string", "description": "Signer identity in the Fulcio certificate, e.g. a GitHub Actions workflow URI or an email" },
              "issuer": { "type": "string", "description": "OIDC issuer, e.g. https://token.actions.githubusercontent.com" }
            }
          }
        }
      }
    },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$", "description": "SPDX license id for the card data, normally CC-BY-4.0" },
    "notes": { "type": "string" },
    "family": { "$ref": "#/$defs/family_ref" }
  },
  "$defs": {
    "card_id": { "type": "string", "pattern": "^occ:[a-z0-9_-]+/[A-Za-z0-9._-]+@\\d+\\.\\d+\\.\\d+$" },
    "family_ref": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "description": "Link from a part card to the family card it inherits from. The part's own fields override the family's. See docs/family-cards.md.",
      "properties": {
        "id": { "$ref": "#/$defs/card_id" },
        "sha256": { "$ref": "#/$defs/sha256", "description": "Optional sha256 of the family card file. If set, the validator checks it, so an edited family can't silently change this part." },
        "select": { "type": "object", "additionalProperties": { "type": ["number", "string"] }, "description": "Selector values for this part, e.g. {resistance: 4.7}. A missing numeric selector falls back to the nominal of the parameter with the same name." }
      }
    },
    "family_card": {
      "type": "object", "additionalProperties": false,
      "required": ["card_version", "card_type", "id", "family", "rules", "sources", "provenance", "license"],
      "properties": {
        "card_version": { "const": "0.2" },
        "card_type": { "const": "family" },
        "id": { "$ref": "#/$defs/card_id" },
        "family": {
          "type": "object", "additionalProperties": false, "required": ["manufacturer", "series", "category", "selectors"],
          "properties": {
            "manufacturer": { "type": "string" },
            "series": { "type": "string" },
            "category": { "$ref": "#/properties/part/properties/category" },
            "description": { "type": "string" },
            "package": { "type": "string" },
            "selectors": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "unit": { "$ref": "#/$defs/unit" }, "values": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Allowed values for a categorical selector, such as packages." } } } }
          }
        },
        "model_files": { "$ref": "#/properties/model_files" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/family_parameter" } },
        "rules": {
          "type": "array",
          "description": "Value-dependent overrides. A rule applies when every selector in 'when' matches. Numeric ranges use min/max (inclusive) and gt/lt (exclusive). Categorical selectors use 'in'.",
          "items": { "type": "object", "additionalProperties": false, "required": ["id", "when", "set"], "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
            "when": { "type": "object", "minProperties": 1, "additionalProperties": { "oneOf": [
              { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "gt": { "type": "number" }, "lt": { "type": "number" } } },
              { "type": "object", "additionalProperties": false, "required": ["in"], "properties": { "in": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } } } ] } },
            "set": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/parameter_override" } },
            "note": { "type": "string" } } }
        },
        "derivation": { "$ref": "#/properties/derivation" },
        "validation": { "$ref": "#/properties/validation" },
        "sources": { "$ref": "#/properties/sources" },
        "provenance": { "$ref": "#/properties/provenance" },
        "license": { "$ref": "#/properties/license" },
        "not_published": { "type": "array", "items": { "type": "string" }, "description": "Facts this family card leaves out because its sources don't state them." },
        "notes": { "type": "string" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "description": "Machine-readable transform. x is the sampled card value, P_file is the value in the model file, P_new is the value written back.",
      "properties": {
        "type": { "enum": ["offset", "scale", "replace", "affine"], "description": "offset: P_new = P_file + (x - reference). scale: P_new = P_file * (x / reference). replace: P_new = x. affine: P_new = factor * x + offset." },
        "reference": { "type": "number", "description": "offset and scale: the card value the model file corresponds to. Defaults to the parameter's nominal." },
        "factor": { "type": "number", "description": "affine only: multiplier on the sampled value" },
        "offset": { "type": "number", "description": "affine only: added after the factor, in param_unit" },
        "param_unit": { "type": "string", "description": "Unit of the model parameter, checked against the card unit where the type allows it" }
      }
    },
    "conditions": {
      "type": "object",
      "description": "Test conditions. Standard keys carry units in the name (see docs/conditions.md). Other keys are allowed; the validator warns on them.",
      "additionalProperties": true,
      "properties": {
        "temperature_c": { "type": "number", "description": "Ambient or case temperature, degC" },
        "temperature_min_c": { "type": "number", "description": "Low end of a temperature range, degC" },
        "temperature_max_c": { "type": "number", "description": "High end of a temperature range, degC" },
        "reference_span_c": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "Temperature span [from, to] a coefficient is defined over, degC" },
        "frequency_hz": { "type": "number", "exclusiveMinimum": 0, "description": "Measurement frequency, Hz" },
        "ac_vrms": { "type": "number", "minimum": 0, "description": "AC test signal level, Vrms" },
        "dc_bias_v": { "type": "number", "description": "DC bias voltage across the part, V" },
        "bias_v": { "type": "number", "description": "Accepted alias for dc_bias_v (used by v0.1 cards), V" },
        "vgs_v": { "type": "number", "description": "Gate-source voltage, V" },
        "vds_v": { "type": "number", "description": "Drain-source voltage, V" },
        "vds_eq_vgs": { "type": "boolean", "description": "Drain tied to gate (VDS = VGS), as in threshold tests" },
        "id_a": { "type": "number", "description": "Drain current, A" },
        "humidity_pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "Relative humidity, %" },
        "duration_h": { "type": "number", "minimum": 0, "description": "Test or stress duration, hours" },
        "preconditioning": { "type": "string", "description": "Free text, e.g. a bake, rest, or burn-in before measurement" }
      }
    },
    "sha256": { "type": "string", "pattern": "^([a-f0-9]{64}|PLACEHOLDER)$" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "unit": { "enum": ["Ohm", "F", "H", "V", "A", "W", "s", "Hz", "K", "degC", "1", "ppm/K", "V/K", "1/K"] },
    "parameter": { "$ref": "#/$defs/parameter_fields", "required": ["name", "unit", "nominal", "distributions", "source_refs"], "unevaluatedProperties": false },
    "family_parameter": { "$ref": "#/$defs/parameter_fields", "required": ["name", "unit"], "unevaluatedProperties": false, "description": "A family parameter. It can leave out nominal, distributions, or source_refs when rules or parts supply them. The resolved card must be complete." },
    "parameter_override": { "$ref": "#/$defs/parameter_fields", "not": { "required": ["name"] }, "unevaluatedProperties": false, "description": "Partial parameter in a family rule. These fields replace the family parameter fields." },
    "parameter_fields": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "unit": { "$ref": "#/$defs/unit" },
        "nominal": { "type": "number" },
        "distributions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/distribution" }, "description": "How the parameter varies. Either exactly one entry with scope total, or a lot and/or device entry with no total. Replaces the v0.1 single distribution. See docs/lot-device-spread.md and docs/migration-v0.1-to-v0.2.md." },
        "conditions": { "$ref": "#/$defs/conditions" },
        "dependence": {
          "type": "array",
          "description": "Multiplicative curve applied to nominal: value(cond) = nominal * curve(cond), linear interpolation",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variable", "points"],
            "properties": {
              "variable": { "type": "string" },
              "interpolation": { "enum": ["linear"] },
              "points": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["x", "value"], "properties": { "x": { "type": "number" }, "value": { "type": "number" } } } }
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "description": "Published limits for this parameter, e.g. from a datasheet, kept apart from the modeling choice in distributions. Same unit as the parameter. Optional.",
          "anyOf": [ { "required": ["min"] }, { "required": ["typ"] }, { "required": ["max"] } ],
          "properties": {
            "min": { "type": "number" },
            "typ": { "type": "number" },
            "max": { "type": "number" },
            "conditions": { "$ref": "#/$defs/conditions", "description": "Conditions the limit is published at, if different from the parameter's conditions" },
            "source_ref": { "type": "string", "description": "ref of the source that publishes this limit" }
          }
        },
        "final_limits": {
          "type": "object",
          "additionalProperties": false,
          "description": "Hard limits on the final sampled value (after curves and offsets), e.g. a class limit",
          "required": ["min", "max", "relative_to_nominal"],
          "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "relative_to_nominal": { "type": "boolean" } }
        },
        "model_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["param", "transform"],
          "properties": {
            "param": { "type": "string", "description": "Parameter name inside the referenced model file" },
            "transform": {
              "description": "How a sampled card value changes that model parameter. The structured form is preferred. A plain string is still accepted but deprecated (the validator warns). See docs/model-binding.md.",
              "oneOf": [ { "type": "string" }, { "$ref": "#/$defs/transform" } ]
            },
            "note": { "type": "string", "description": "Optional free-text explanation for humans" }
          }
        },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "type", "applies_to", "kind", "params", "basis", "confidence"],
      "properties": {
        "type": { "enum": ["normal", "uniform", "lognormal", "triangular", "empirical"] },
        "applies_to": { "enum": ["value", "additive_offset", "relative_offset"], "description": "value: sample is the parameter itself. additive_offset: final = curve value + X. relative_offset: final = curve value * (1 + X)." },
        "kind": { "enum": ["population", "epistemic"], "description": "population: part-to-part spread. epistemic: uncertainty about our own knowledge (see GUM / JCGM 101)." },
        "params": { "type": "object" },
        "truncate": { "type": "object", "additionalProperties": false, "properties": { "min": { "type": "number" }, "max": { "type": "number" } } },
        "basis": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "scope": { "enum": ["total", "lot", "device"], "description": "Which part of the spread this entry is. total: all of it. lot: lot-to-lot spread, one draw shared by every part in a lot (SPICE LOT). device: device-to-device spread within one lot (SPICE DEV). lot and device only make sense for kind: population." }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "normal" } } }, "then": { "properties": { "params": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["mean", "sigma"], "properties": { "mean": { "type": "number" }, "sigma": { "type": "number", "exclusiveMinimum": 0 } } },
          { "type": "object", "additionalProperties": false, "required": ["mean", "sigma_pct"], "properties": { "mean": { "type": "number" }, "sigma_pct": { "type": "number", "exclusiveMinimum": 0 } } } ] } } } },
        { "if": { "properties": { "type": { "const": "uniform" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "type": "number" }, "max": { "type": "number" } } } } } },
        { "if": { "properties": { "type": { "const": "lognormal" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["mu", "sigma"], "properties": { "mu": { "type": "number" }, "sigma": { "type": "number", "exclusiveMinimum": 0 } } } } } },
        { "if": { "properties": { "type": { "const": "triangular" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["min", "mode", "max"], "properties": { "min": { "type": "number" }, "mode": { "type": "number" }, "max": { "type": "number" } } } } } },
        { "if": { "properties": { "type": { "const": "empirical" } } }, "then": { "properties": { "params": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["samples_uri", "sha256"], "properties": { "samples_uri": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha256" } } },
          { "type": "object", "additionalProperties": false, "required": ["bins"], "properties": { "bins": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["value", "probability"], "properties": { "value": { "type": "number" }, "probability": { "type": "number", "minimum": 0, "maximum": 1 } } } } } } ] } } } }
      ]
    }
  }
}
