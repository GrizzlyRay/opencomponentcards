{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GrizzlyRay/opencomponentcards/schema/signers.schema.json",
  "title": "OpenComponentCards trusted signers",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "levels", "signers"],
  "properties": {
    "policy_version": {"const": 1},
    "levels": {"const": ["registry", "community", "verified"]},
    "signers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "identity", "scope", "added", "approval"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["registry", "community", "verified"]},
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["san_regex", "issuer"],
            "properties": {
              "san_regex": {"type": "string", "pattern": "^\\^.*\\$$"},
              "issuer": {"type": "string", "format": "uri", "pattern": "^https://"}
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "manufacturers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          },
          "added": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "approval": {"type": "string", "pattern": "^https://github\\.com/GrizzlyRay/opencomponentcards/(issues|pull)/\\d+$"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
